{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northgo-inquiry-crud",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  // Demo credentials are NOT shipped here (publish-app security). Set via
  // `wrangler secret put` / dashboard: ADMIN_USERNAME, ADMIN_PASSWORD, SESSION_SECRET,
  // and ALLOWED_ORIGIN=https://ymonsterb-hash.github.io
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northgo-inquiries",
      "database_id": "b7649afb-7ca4-455b-a0e7-3413990f4848"
    }
  ]
}
