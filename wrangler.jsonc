{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northgo-inquiry-crud",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://ymonsterb-hash.github.io",
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "northgo-admin",
    "SESSION_SECRET": "northgo-demo-session-change-me"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northgo-inquiries",
      "database_id": "b7649afb-7ca4-455b-a0e7-3413990f4848"
    }
  ]
}
