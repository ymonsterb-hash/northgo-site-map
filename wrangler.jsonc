{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northgo-inquiry-crud",
  "main": "worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  // Set via `wrangler secret put` (do not commit values):
  // ADMIN_USERNAME, ADMIN_PASSWORD, SESSION_SECRET,
  // ALLOWED_ORIGIN=https://ymonsterb-hash.github.io
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northgo-inquiries",
      "database_id": "64052cd1-0b21-4481-a4e3-536b2e54c1db",
      "migrations_dir": "d1/migrations"
    }
  ]
}
